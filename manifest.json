{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "tool-mini-notes-summarizer",
      "min_version": "1.0.1"
    }
  ],
  "optional_executas": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "tools.invoke"
  ],
  "host_capabilities": [
    "llm.sample",
    "aps.kv"
  ],
  "system_prompt_addendum": "Mini Notes stores notes through Anna storage and summarizes them through the bundled Executa sampling tool.",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "entry": "index.html",
        "min_size": {
          "w": 360,
          "h": 480
        },
        "default_size": {
          "w": 780,
          "h": 760
        },
        "resizable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "storage": [
        "get",
        "set"
      ],
      "tools": [
        "tool-mini-notes-summarizer"
      ],
      "llm": [
        "complete"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "user_id": 1
  }
}
